# Copie ce fichier vers .env puis ajuste si besoin :
#   Windows :      copy .env.example .env
#   macOS/Linux :  cp .env.example .env

# ── Base de données (docker compose s'en sert pour créer le conteneur Postgres)
POSTGRES_USER=assistant_financier
POSTGRES_PASSWORD=assistant_financier_dev
POSTGRES_DB=assistant_financier

# ── API
PORT=5000
COOKIE_SECRET=dev-cookie-secret-a-changer
# NODE_ENV : "production" active les cookies secure (HTTPS uniquement).
# Laisser vide/commenté en dev, y compris hors Docker.
# NODE_ENV=development

# ── Clés JWT (RS256), OBLIGATOIRES — PEM aplati (sauts de ligne encodés \n).
# Pour les générer, une seule commande, puis colle les 2 lignes affichées ici :
#   docker compose run --rm --no-deps server node scripts/generer-cles.js
# (hors Docker, avec Node installé :  node scripts/generer-cles.js —
#  méthode openssl équivalente documentée dans le script et le README)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
# Origines navigateur autorisées par le CORS, séparées par des virgules
# (React en dev, plus tard le domaine de prod, app mobile Web éventuelle...).
# Une app mobile native (Flutter/React Native Android/iOS) n'est PAS concernée par le CORS.
CLIENT_URLS=http://localhost:5173

# ── Email (Resend) — optionnel en dev : sans clé, les emails (et leurs liens
# de vérification) s'affichent dans les logs du conteneur serveur.
# RESEND_API_KEY=
# EMAIL_EXPEDITEUR="Assistant Financier <no-reply@tondomaine.com>"

# ── Chatbot Grok (optionnel)
# GROK_API_KEY=
# GROK_MODEL=grok-2-latest
# GROK_BASE_URL=https://api.x.ai/v1/chat/completions

# URL utilisée uniquement si tu lances Prisma DEPUIS ta machine (hors Docker).
# Dans les conteneurs, docker-compose fournit la bonne URL (hôte "db") tout seul.
DATABASE_URL="postgresql://assistant_financier:assistant_financier_dev@localhost:5432/assistant_financier?schema=public"
